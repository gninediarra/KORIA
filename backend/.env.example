# GabèsEye Backend — Environment Variables
# Copiez ce fichier vers .env et remplissez vos valeurs

# Groq API key — obtenez une clé gratuite sur console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optionnel : SentinelHub pour données satellite réelles
SENTINELHUB_CLIENT_ID=your_sentinelhub_client_id
SENTINELHUB_CLIENT_SECRET=your_sentinelhub_client_secret
